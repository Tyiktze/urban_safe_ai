# ======================================================
# 🌍 UrbanSafe AI - Environment Configuration
# ------------------------------------------------------
# ⚠️ Do NOT commit real API keys to public repositories.
# Create a .env file in your project root and fill in
# the values below with your actual credentials.
# ======================================================


# =========================
# 🔥 Firebase Configuration
# =========================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id


# =========================
# 🗺️ Google Maps API
# =========================
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key


# =========================
# 🤖 Gemini AI API
# =========================
VITE_GEMINI_API_KEY=your_gemini_api_key


# =========================
# 🌦️ OpenWeatherMap API
# =========================
VITE_OPENWEATHER_API_KEY=your_open_weather_api_key


# =========================
# ☁️ Cloud Functions
# =========================
# Update after deploying Firebase Functions
VITE_FUNCTIONS_BASE_URL=https://us-central1-your_project_id.cloudfunctions.net
